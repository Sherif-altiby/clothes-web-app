model User {
  id String @id @default(cuid())

  name     String
  email    String  @unique
  password String
  avatar   String?
  phone    String?
  address  String?

  role Role @default(USER)

  cart      Cart?
  favorites Favorite[]
  orders    Order[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
